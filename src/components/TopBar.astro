---
import { site, mapsUrl } from '../config/site';
import { telLink } from '../lib/whatsapp';
import Icon from './Icon.astro';
import Pending from './Pending.astro';

const a = site.address.value;
const hasHours = site.hours.value.length > 0;
---
<div class="topbar">
  <div class="container topbar__inner">
    <a class="topbar__item topbar__item--place" href={mapsUrl()} target="_blank" rel="noopener noreferrer">
      <Icon name="map-pin" size={16} />
      <span>{a.sector.split(',').pop()?.trim()}, {a.city}</span>
      <Pending verified={site.address.verified} note={site.address.note} />
    </a>
    <span class="topbar__item topbar__item--hours">
      <Icon name="clock" size={16} />
      {hasHours ? <span>{site.hours.value[0]!.days}: {site.hours.value[0]!.time}</span> : <span>Horario: consúltalo por WhatsApp</span>}
    </span>
    <a class="topbar__item topbar__item--phone" href={telLink()}>
      <Icon name="phone" size={16} />
      <span><span class="sr-only">Llamar al </span>{site.phone.value.display}</span>
      <Pending verified={site.phone.verified} note={site.phone.note} />
    </a>
  </div>
</div>

<style>
  .topbar {
    background: var(--c-bg-soft);
    border-bottom: 1px solid var(--c-line);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-5);
    min-height: 40px;
  }
  .topbar__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: inherit;
    text-decoration: none;
    min-height: 40px;
  }
  .topbar__item svg {
    color: var(--c-teal-700);
    flex: none;
  }
  a.topbar__item:hover {
    color: var(--c-ink);
  }
  /* En móvil: solo el dato más útil (ubicación). El teléfono vive en el menú y en contacto. */
  .topbar__item--hours,
  .topbar__item--phone {
    display: none;
  }
  @media (min-width: 720px) {
    .topbar__inner {
      justify-content: flex-end;
    }
    .topbar__item--place {
      margin-right: auto;
    }
    .topbar__item--phone {
      display: inline-flex;
    }
  }
  @media (min-width: 960px) {
    .topbar__item--hours {
      display: inline-flex;
    }
  }
</style>
