---
/**
 * Botón flotante de WhatsApp: discreto, sin parpadeos ni ventanas.
 * Aparece tras desplazarse más allá del hero (para no duplicar su botón).
 */
import { waMessages } from '../config/whatsapp';
import BrandIcon from './BrandIcon.astro';
import WaLink from './WaLink.astro';

interface Props {
  message?: string;
}
const { message = waMessages.floating } = Astro.props;
---
<WaLink message={message} context="flotante" class="fab" data-fab aria-label="Escríbenos por WhatsApp">
  <BrandIcon name="whatsapp" size={26} />
  <span class="fab__label" aria-hidden="true">Escríbenos</span>
</WaLink>

<style>
  .fab {
    position: fixed;
    z-index: 40;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    width: 56px;
    height: 56px;
    border-radius: var(--r-pill);
    background: var(--c-teal-700);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    box-shadow:
      0 10px 24px -8px rgb(10 115 120 / 0.55),
      0 2px 6px rgb(24 52 66 / 0.12);
    transition:
      opacity var(--dur-med) ease,
      transform var(--dur-med) var(--ease-out),
      background-color var(--dur-fast) ease;
  }
  .fab:hover {
    background: var(--c-teal-800);
    color: #fff;
  }
  .fab:active {
    transform: scale(0.96);
  }
  .fab__label {
    display: none;
  }
  .fab[data-state='hidden'] {
    opacity: 0;
    transform: translateY(16px) scale(0.9);
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    .fab {
      width: auto;
      padding: 0 var(--sp-5) 0 var(--sp-4);
      right: max(24px, env(safe-area-inset-right));
      bottom: max(24px, env(safe-area-inset-bottom));
    }
    .fab__label {
      display: inline;
    }
  }
</style>
