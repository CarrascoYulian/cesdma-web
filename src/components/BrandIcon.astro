---
/** Iconos de marca (Simple Icons, CC0). */
import { siWhatsapp, siInstagram } from 'simple-icons';

interface Props {
  name: 'whatsapp' | 'instagram';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const path = { whatsapp: siWhatsapp.path, instagram: siInstagram.path }[name];
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  class={className}
  aria-hidden="true"
  focusable="false"
><path d={path} /></svg>
