---
import { site } from '../config/site';
import { waMessages } from '../config/whatsapp';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import WaLink from './WaLink.astro';
import { slides, src, srcset } from '../data/photos';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__banner">
    <!-- El texto va primero en el código (orden de lectura) y se superpone a las fotos con un degradado blanco. -->
    <div class="hero__content">
      <p class="eyebrow">Centro de Sonografía y Diagnósticos Médico</p>
      <h1 id="hero-title">
        Atención cercana y estudios diagnósticos <em>en un mismo lugar.</em>
      </h1>
      <p class="hero__lead">
        Consultas médicas, sonografías, laboratorio y estudios del corazón para ti y tu familia. Escríbenos y
        coordinamos tu cita contigo, sin complicaciones.
      </p>
      <div class="hero__actions">
        <WaLink message={waMessages.hero} context="hero" class="btn">
          <BrandIcon name="whatsapp" size={20} />
          Solicitar una cita
        </WaLink>
        <a href="#servicios" class="btn btn--ghost">
          Conocer nuestros servicios
          <Icon name="arrow-down" size={18} />
        </a>
      </div>
    </div>

    <div class="hero__fade" aria-hidden="true"></div>

    <section class="carousel" aria-roledescription="carrusel" aria-label="Servicios de CESDMA" data-carousel>
      <div class="carousel__track" aria-live="polite" data-carousel-track>
        {
          slides.map((s, i) => (
            <div
              class:list={['carousel__slide', { 'is-active': i === 0 }]}
              role="group"
              aria-roledescription="diapositiva"
              aria-label={`${i + 1} de ${slides.length}: ${s.title}`}
              aria-hidden={i === 0 ? undefined : 'true'}
              data-slide
            >
              <img
                src={src(s.photo, 1200)}
                srcset={srcset(s.photo, [800, 1200])}
                sizes="(min-width: 1024px) 66vw, 100vw"
                alt={s.photo.alt}
                width="1200"
                height="800"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'low'}
                decoding={i === 0 ? 'sync' : 'async'}
                class="carousel__img"
              />
              <p class="carousel__caption">
                <a href={s.href} class="carousel__link">
                  {s.title}<span class="sr-only">: {s.text} Ver más</span>
                  <Icon name="arrow-right" size={16} />
                </a>
                <span class="carousel__tag">Imagen ilustrativa</span>
              </p>
            </div>
          ))
        }
      </div>

      <div class="carousel__controls" data-carousel-controls hidden>
        <div class="carousel__dots" role="group" aria-label="Elegir imagen">
          {
            slides.map((s, i) => (
              <button
                type="button"
                class="carousel__dot"
                aria-label={`Mostrar ${i + 1}: ${s.title}`}
                aria-current={i === 0 ? 'true' : 'false'}
                data-carousel-dot={i}
              />
            ))
          }
        </div>
        <button type="button" class="carousel__btn" data-carousel-play aria-label="Pausar el carrusel" data-state="paused">
          <Icon name="pause" size={18} class="carousel__icon-pause" />
          <Icon name="play" size={18} class="carousel__icon-play" />
        </button>
        <button type="button" class="carousel__btn" data-carousel-prev aria-label="Imagen anterior">
          <Icon name="chevron-left" size={20} />
        </button>
        <button type="button" class="carousel__btn" data-carousel-next aria-label="Imagen siguiente">
          <Icon name="chevron-right" size={20} />
        </button>
      </div>
    </section>
  </div>

  <div class="container">
    <ul class="hero__facts" aria-label="Lo que encontrarás en CESDMA">
      <li><Icon name="stethoscope" size={18} /> Medicina general y más de {site.specialtiesCount.value} especialidades</li>
      <li><Icon name="scan-heart" size={18} /> Sonografías y estudios cardiovasculares</li>
      <li><Icon name="message-circle" size={18} /> Citas coordinadas por WhatsApp</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1rem, 0.5rem + 1.5vw, 2rem) clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  /* Banner a todo el ancho: fotos detrás, degradado blanco y texto encima. */
  .hero__banner {
    --pad: clamp(1.25rem, 0.5rem + 3vw, 4.5rem);
    --img-h: clamp(260px, 72vw, 460px);
    position: relative;
    isolation: isolate;
    display: grid;
    width: min(100% - 2 * var(--gutter), 1440px);
    margin-inline: auto;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--c-line);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    grid-row: 2;
    display: grid;
    gap: var(--sp-5);
    margin-top: -2.5rem;
    padding: 0 var(--pad) var(--pad);
  }
  h1 {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 1.05;
  }
  h1 em {
    font-style: normal;
    color: var(--c-teal-700);
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--c-muted);
    max-width: 34rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    padding-top: var(--sp-2);
  }

  /* Móvil: foto arriba, se funde en blanco hacia abajo. */
  .hero__fade {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    height: var(--img-h);
    background: linear-gradient(180deg, rgb(255 255 255 / 0) 35%, #fff calc(100% - 2.5rem));
    pointer-events: none;
  }

  .carousel {
    position: relative;
    grid-row: 1;
    height: var(--img-h);
    touch-action: pan-y;
  }
  .carousel__track {
    position: absolute;
    inset: 0;
  }
  .carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }
  .carousel__slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  .carousel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .carousel__caption {
    position: absolute;
    z-index: 3;
    top: var(--sp-3);
    left: var(--sp-3);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.94);
    box-shadow: var(--shadow-md);
  }
  .carousel__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 28px;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--c-ink);
    text-decoration: none;
  }
  .carousel__link:hover {
    color: var(--c-teal-700);
    text-decoration: underline;
  }
  .carousel__link :global(svg) {
    color: var(--c-teal-700);
  }
  .carousel__tag {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }

  .carousel__controls {
    position: absolute;
    z-index: 3;
    right: var(--sp-3);
    bottom: calc(2.5rem + var(--sp-2));
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 4px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.94);
    box-shadow: var(--shadow-md);
  }
  .carousel__controls[hidden] {
    display: none;
  }
  .carousel__dots {
    display: flex;
    margin-right: var(--sp-1);
  }
  .carousel__dot {
    display: grid;
    place-items: center;
    width: 28px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .carousel__dot::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: var(--r-pill);
    border: 2px solid var(--c-teal-700);
    transition:
      width var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .carousel__dot[aria-current='true']::before {
    width: 22px;
    background: var(--c-teal-700);
  }
  .carousel__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    border: 0;
    background: none;
    color: var(--c-ink);
    cursor: pointer;
    transition: background-color var(--dur-fast) ease;
  }
  .carousel__btn:hover {
    background: var(--c-bg-soft);
  }
  .carousel__btn[data-state='playing'] :global(.carousel__icon-play),
  .carousel__btn[data-state='paused'] :global(.carousel__icon-pause) {
    display: none;
  }

  .hero__facts {
    list-style: none;
    display: grid;
    gap: var(--sp-2) var(--sp-6);
    padding: var(--sp-5) 0 0;
    font-size: var(--fs-small);
    color: var(--c-ink);
  }
  .hero__facts li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .hero__facts :global(svg) {
    color: var(--c-teal-700);
    flex: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .carousel__slide {
      transition:
        opacity 0.6s var(--ease-out),
        visibility 0s linear 0.6s;
    }
    .carousel__slide.is-active {
      transition:
        opacity 0.6s var(--ease-out),
        visibility 0s;
    }
  }

  @media (max-width: 479px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
    /* En pantallas pequeñas bastan los puntos, la pausa y el deslizamiento. */
    .carousel__btn[data-carousel-prev],
    .carousel__btn[data-carousel-next] {
      display: none;
    }
  }
  @media (min-width: 720px) {
    .hero__facts {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  /* Escritorio: el texto queda a la izquierda sobre blanco y la foto
     aparece a la derecha, fundiéndose con el degradado. */
  @media (min-width: 1024px) {
    .hero__banner {
      --copy: calc(var(--pad) + min(34rem, 44vw));
      min-height: clamp(520px, 72vh, 640px);
      align-items: center;
    }
    .hero__content {
      grid-row: 1;
      max-width: var(--copy);
      margin: 0;
      padding: var(--pad) 0 var(--pad) var(--pad);
    }
    .hero__fade {
      inset: 0;
      height: auto;
      background: linear-gradient(
        90deg,
        #fff 0,
        #fff calc(var(--copy) + 1rem),
        rgb(255 255 255 / 0.75) calc(var(--copy) + 6rem),
        rgb(255 255 255 / 0) calc(var(--copy) + 16rem)
      );
    }
    .carousel {
      position: absolute;
      inset: 0 0 0 calc(var(--pad) + 18rem);
      height: auto;
    }
    .carousel__caption {
      left: auto;
      right: var(--sp-5);
      top: var(--sp-5);
      align-items: flex-end;
    }
    .carousel__controls {
      right: var(--sp-5);
      bottom: var(--sp-5);
    }
  }
</style>
