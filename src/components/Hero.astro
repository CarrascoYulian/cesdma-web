---
import { site } from '../config/site';
import { waMessages } from '../config/whatsapp';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import WaLink from './WaLink.astro';
import { slides, src, srcset } from '../data/photos';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Centro de Sonografía y Diagnósticos Médico</p>
      <h1 id="hero-title">
        Atención cercana y estudios diagnósticos <em>en un mismo lugar.</em>
      </h1>
      <p class="hero__lead">
        Consultas médicas, sonografías, laboratorio y estudios del corazón para ti y tu familia. Escríbenos y
        coordinamos tu cita contigo, sin complicaciones.
      </p>
      <div class="hero__actions">
        <WaLink message={waMessages.hero} context="hero" class="btn">
          <BrandIcon name="whatsapp" size={20} />
          Solicitar una cita
        </WaLink>
        <a href="#servicios" class="btn btn--ghost">
          Conocer nuestros servicios
          <Icon name="arrow-down" size={18} />
        </a>
      </div>
      <ul class="hero__facts" aria-label="Lo que encontrarás en CESDMA">
        <li><Icon name="stethoscope" size={18} /> Medicina general y más de {site.specialtiesCount.value} especialidades</li>
        <li><Icon name="scan-heart" size={18} /> Sonografías y estudios cardiovasculares</li>
        <li><Icon name="message-circle" size={18} /> Citas coordinadas por WhatsApp</li>
      </ul>
    </div>

    <div class="hero__visual">
      <section class="carousel" aria-roledescription="carrusel" aria-label="Servicios de CESDMA" data-carousel>
        <div class="carousel__frame">
          <div class="carousel__track" aria-live="polite" data-carousel-track>
            {
              slides.map((s, i) => (
                <div
                  class:list={['carousel__slide', { 'is-active': i === 0 }]}
                  role="group"
                  aria-roledescription="diapositiva"
                  aria-label={`${i + 1} de ${slides.length}: ${s.title}`}
                  aria-hidden={i === 0 ? undefined : 'true'}
                  data-slide
                >
                  <img
                    src={src(s.photo, 1200)}
                    srcset={srcset(s.photo, [800, 1200])}
                    sizes="(min-width: 960px) 46vw, (min-width: 640px) 90vw, 100vw"
                    alt={s.photo.alt}
                    width="1200"
                    height="800"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'low'}
                    decoding={i === 0 ? 'sync' : 'async'}
                    class="carousel__img"
                  />
                  <div class="carousel__caption">
                    <p class="carousel__title">{s.title}</p>
                    <p class="carousel__text">{s.text}</p>
                    <a href={s.href} class="link-arrow carousel__link">
                      Ver más<span class="sr-only"> sobre {s.title}</span>
                      <Icon name="arrow-right" size={16} />
                    </a>
                  </div>
                </div>
              ))
            }
          </div>
          <p class="carousel__tag">Imagen ilustrativa</p>
        </div>

        <div class="carousel__controls" data-carousel-controls hidden>
          <div class="carousel__dots" role="group" aria-label="Elegir imagen">
            {
              slides.map((s, i) => (
                <button
                  type="button"
                  class="carousel__dot"
                  aria-label={`Mostrar ${i + 1}: ${s.title}`}
                  aria-current={i === 0 ? 'true' : 'false'}
                  data-carousel-dot={i}
                />
              ))
            }
          </div>
          <div class="carousel__buttons">
            <button type="button" class="carousel__btn" data-carousel-play aria-label="Pausar el carrusel" data-state="paused">
              <Icon name="pause" size={18} class="carousel__icon-pause" />
              <Icon name="play" size={18} class="carousel__icon-play" />
            </button>
            <button type="button" class="carousel__btn" data-carousel-prev aria-label="Imagen anterior">
              <Icon name="chevron-left" size={20} />
            </button>
            <button type="button" class="carousel__btn" data-carousel-next aria-label="Imagen siguiente">
              <Icon name="chevron-right" size={20} />
            </button>
          </div>
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(3rem, 2rem + 4vw, 6rem);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: var(--sp-5);
    max-width: 38rem;
  }
  h1 {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 1.05;
  }
  h1 em {
    font-style: normal;
    color: var(--c-teal-700);
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--c-muted);
    max-width: 34rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    padding-top: var(--sp-2);
  }
  .hero__facts {
    list-style: none;
    display: grid;
    gap: var(--sp-2);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-small);
    color: var(--c-ink);
  }
  .hero__facts li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .hero__facts :global(svg) {
    color: var(--c-teal-700);
    flex: none;
  }

  /* Carrusel */
  .hero__visual {
    position: relative;
    min-width: 0;
  }
  .carousel {
    display: grid;
    gap: var(--sp-3);
  }
  .carousel__frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--c-bg-soft);
    border: 1px solid var(--c-line);
  }
  .carousel__track {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
  }
  .carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
  }
  .carousel__slide.is-active {
    opacity: 1;
    visibility: visible;
  }
  .carousel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .carousel__caption {
    position: absolute;
    left: var(--sp-4);
    bottom: var(--sp-4);
    max-width: min(300px, calc(100% - 2 * var(--sp-4)));
    padding: var(--sp-3) var(--sp-4);
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
  }
  .carousel__title {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--c-ink);
    line-height: var(--lh-snug);
  }
  .carousel__text {
    font-size: var(--fs-xs);
    color: var(--c-muted);
    margin-top: 2px;
  }
  .carousel__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 32px;
    font-size: var(--fs-small);
    font-weight: 600;
  }
  .carousel__tag {
    position: absolute;
    top: var(--sp-3);
    right: var(--sp-3);
    padding: 2px 10px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.92);
    color: var(--c-ink);
    font-size: var(--fs-xs);
    font-weight: 500;
  }
  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }
  .carousel__controls[hidden] {
    display: none;
  }
  .carousel__dots {
    display: flex;
    gap: 2px;
  }
  .carousel__dot {
    display: grid;
    place-items: center;
    width: 32px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .carousel__dot::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: var(--r-pill);
    border: 2px solid var(--c-teal-700);
    transition:
      width var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .carousel__dot[aria-current='true']::before {
    width: 24px;
    background: var(--c-teal-700);
  }
  .carousel__buttons {
    display: flex;
    gap: var(--sp-2);
  }
  .carousel__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    border: 1px solid var(--c-line-strong);
    background: #fff;
    color: var(--c-ink);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .carousel__btn:hover {
    border-color: var(--c-teal-700);
    background: var(--c-bg-soft);
  }
  .carousel__btn[data-state='playing'] :global(.carousel__icon-play),
  .carousel__btn[data-state='paused'] :global(.carousel__icon-pause) {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .carousel__slide {
      transition:
        opacity 0.7s var(--ease-out),
        visibility 0s linear 0.7s;
    }
    .carousel__slide.is-active {
      transition:
        opacity 0.7s var(--ease-out),
        visibility 0s;
    }
  }

  @media (max-width: 479px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
    .carousel__caption {
      left: var(--sp-3);
      bottom: var(--sp-3);
      padding: var(--sp-2) var(--sp-3);
    }
    .carousel__text {
      display: none;
    }
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
    }
    .carousel__frame {
      aspect-ratio: 1 / 1;
    }
  }
</style>
