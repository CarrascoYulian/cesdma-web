---
import { site } from '../config/site';
import { waMessages } from '../config/whatsapp';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import WaLink from './WaLink.astro';

const img = site.heroImage;
const chips = ['Consulta general', 'Sonografía 4D', 'Laboratorio', 'EKG', 'Ecocardiograma', 'Doppler'];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Centro de Sonografía y Diagnósticos Médico</p>
      <h1 id="hero-title">
        Atención cercana y estudios diagnósticos <em>en un mismo lugar.</em>
      </h1>
      <p class="hero__lead">
        Consultas médicas, sonografías, laboratorio y estudios del corazón para ti y tu familia. Escríbenos y
        coordinamos tu cita contigo, sin complicaciones.
      </p>
      <div class="hero__actions">
        <WaLink message={waMessages.hero} context="hero" class="btn">
          <BrandIcon name="whatsapp" size={20} />
          Solicitar una cita
        </WaLink>
        <a href="#servicios" class="btn btn--ghost">
          Conocer nuestros servicios
          <Icon name="arrow-down" size={18} />
        </a>
      </div>
      <ul class="hero__facts" aria-label="Lo que encontrarás en CESDMA">
        <li><Icon name="stethoscope" size={18} /> Medicina general y más de {site.specialtiesCount.value} especialidades</li>
        <li><Icon name="scan-heart" size={18} /> Sonografías y estudios cardiovasculares</li>
        <li><Icon name="message-circle" size={18} /> Citas coordinadas por WhatsApp</li>
      </ul>
    </div>

    <div class="hero__visual" aria-hidden={img ? undefined : 'true'}>
      <div class="hero__panel">
        {
          img ? (
            <img src={img.src} alt={img.alt} width={img.width} height={img.height} fetchpriority="high" class="hero__photo" />
          ) : (
            <svg class="hero__fan" viewBox="0 0 400 400" fill="none" aria-hidden="true">
              <defs>
                <linearGradient id="fan" x1="200" y1="20" x2="200" y2="360" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#0a7378" stop-opacity=".16" />
                  <stop offset="1" stop-color="#0fb5a0" stop-opacity=".02" />
                </linearGradient>
              </defs>
              <path d="M200 20 L40 320 A340 340 0 0 0 360 320 Z" fill="url(#fan)" />
              {[300, 250, 200, 150, 100].map((r, i) => (
                <path
                  class="hero__arc"
                  style={`--i:${i}`}
                  d={`M${200 - r * 0.47} ${20 + r * 0.883} A${r} ${r} 0 0 0 ${200 + r * 0.47} ${20 + r * 0.883}`}
                  stroke={i % 2 ? '#087f83' : '#0fb5a0'}
                  stroke-opacity={0.55 - i * 0.06}
                  stroke-width="2"
                  stroke-linecap="round"
                />
              ))}
              <rect x="168" y="6" width="64" height="18" rx="9" fill="#0a7378" />
            </svg>
          )
        }

        <div class="hero__card hero__card--chat">
          <p class="hero__card-label">
            <BrandIcon name="whatsapp" size={16} /> Así de sencillo
          </p>
          <p class="hero__bubble">
            Hola, CESDMA. Me gustaría coordinar una cita.
            <span class="hero__bubble-meta">
              <Icon name="check-check" size={14} />
            </span>
          </p>
        </div>

        <div class="hero__card hero__card--chips">
          <p class="hero__card-label">En un mismo lugar</p>
          <ul>
            {chips.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(3rem, 2rem + 4vw, 6rem);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    align-items: center;
  }
  .hero__copy {
    display: grid;
    gap: var(--sp-5);
    max-width: 38rem;
  }
  h1 {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 1.05;
  }
  h1 em {
    font-style: normal;
    color: var(--c-teal-700);
  }
  .hero__lead {
    font-size: var(--fs-lead);
    color: var(--c-muted);
    max-width: 34rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    padding-top: var(--sp-2);
  }
  .hero__facts {
    list-style: none;
    display: grid;
    gap: var(--sp-2);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-small);
    color: var(--c-ink);
  }
  .hero__facts li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .hero__facts :global(svg) {
    color: var(--c-teal-700);
    flex: none;
  }

  /* Composición visual */
  .hero__visual {
    position: relative;
  }
  .hero__panel {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 90% at 50% 100%, #e3f4f2 0%, transparent 70%),
      var(--c-bg-soft);
    border: 1px solid var(--c-line);
    overflow: hidden;
  }
  .hero__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__fan {
    position: absolute;
    inset: 6% 8% 0;
    width: 84%;
    height: 94%;
  }
  .hero__card {
    position: absolute;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-lg);
    padding: var(--sp-4);
  }
  .hero__card-label {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-muted);
    margin-bottom: var(--sp-3);
  }
  .hero__card-label :global(svg) {
    color: var(--c-teal-700);
  }
  .hero__card--chat {
    top: 30%;
    right: 4%;
    width: min(270px, 62%);
  }
  .hero__bubble {
    position: relative;
    padding: var(--sp-3) var(--sp-4) var(--sp-5);
    border-radius: 14px 14px 4px 14px;
    background: #e7f6f3;
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--c-ink);
  }
  .hero__bubble-meta {
    position: absolute;
    right: 10px;
    bottom: 6px;
    color: var(--c-blue);
  }
  .hero__card--chips {
    left: 5%;
    bottom: 7%;
    width: min(300px, 70%);
  }
  .hero__card--chips ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .hero__card--chips li {
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-line);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__arc {
      stroke-dasharray: 600;
      stroke-dashoffset: 600;
      animation: arc-draw 1.6s var(--ease-out) forwards;
      animation-delay: calc(0.15s + var(--i) * 0.12s);
    }
    .hero__card {
      animation: card-in 0.8s var(--ease-out) both;
    }
    .hero__card--chat {
      animation-delay: 0.45s;
    }
    .hero__card--chips {
      animation-delay: 0.65s;
    }
  }
  @keyframes arc-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* En móvil la composición gráfica se omite: el mensaje y las acciones van primero. */
  @media (max-width: 639px) {
    .hero__visual {
      display: none;
    }
  }
  @media (max-width: 479px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
    }
    .hero__panel {
      aspect-ratio: 4 / 4.4;
    }
  }
</style>
