---
/**
 * Icono de Lucide renderizado como SVG en línea (sin JS en el navegador).
 * Uso: <Icon name="stethoscope" />
 */
import { icons } from 'lucide';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
  label?: string;
}
const { name, size = 24, class: className, strokeWidth = 1.75, label } = Astro.props;
const key = name
  .split('-')
  .map((p) => p.charAt(0).toUpperCase() + p.slice(1))
  .join('') as keyof typeof icons;
const node = icons[key] as unknown as Array<[string, Record<string, string>]> | undefined;
if (!node) throw new Error(`Icono no encontrado: ${name}`);
const inner = node
  .map(([tag, attrs]) => `<${tag} ${Object.entries(attrs).map(([k, v]) => `${k}="${v}"`).join(' ')}/>`)
  .join('');
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
