---
import { categories } from '../data/services';
import Icon from './Icon.astro';

const tiles = [
  ...categories.map((c) => ({ label: c.short === 'Cardiovascular' ? 'Estudios del corazón' : c.name, href: '#servicios', filter: c.id, icon: c.icon })),
  { label: 'Especialidades', href: '#especialidades', filter: undefined, icon: 'users-round' },
];
---
<nav class="quick" aria-label="Acceso rápido a servicios">
  <div class="container">
    <ul class="quick__list">
      {
        tiles.map((t, i) => (
          <li data-reveal style={`--reveal-i:${i}`}>
            <a href={t.href} data-filter-link={t.filter} class="quick__tile">
              <span class="quick__icon">
                <Icon name={t.icon} size={22} />
              </span>
              <span class="quick__label">{t.label}</span>
              <Icon name="arrow-right" size={16} class="quick__arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .quick {
    position: relative;
    margin-top: calc(-1 * clamp(1.5rem, 1rem + 2vw, 3rem));
    padding-bottom: var(--sp-4);
  }
  .quick__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3);
  }
  .quick__list li:last-child {
    grid-column: 1 / -1;
  }
  .quick__tile {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    height: 100%;
    min-height: 64px;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: #fff;
    color: var(--c-ink);
    font-weight: 600;
    font-size: var(--fs-small);
    line-height: 1.25;
    text-decoration: none;
    transition:
      border-color var(--dur-fast) ease,
      transform var(--dur-med) var(--ease-out),
      box-shadow var(--dur-med) ease;
  }
  .quick__tile:hover {
    color: var(--c-ink);
    border-color: var(--c-turquoise);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .quick__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--c-bg-tint);
    color: var(--c-teal-700);
  }
  .quick__label {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 399px) {
    .quick__tile {
      padding-inline: var(--sp-3);
      gap: var(--sp-2);
    }
    .quick__tile :global(.quick__arrow) {
      display: none;
    }
  }
  .quick__tile :global(.quick__arrow) {
    color: var(--c-muted);
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .quick__tile:hover :global(.quick__arrow) {
    transform: translateX(3px);
    color: var(--c-teal-700);
  }
  @media (min-width: 720px) {
    .quick__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .quick__list li:last-child {
      grid-column: auto;
    }
  }
  @media (min-width: 1100px) {
    .quick__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
