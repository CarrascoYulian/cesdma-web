# Copia este archivo como .env y ajusta los valores.
# Dominio público del sitio (para canonical, sitemap y Open Graph).
PUBLIC_SITE_URL=https://www.cesdma.com.do
# Muestra etiquetas "Por confirmar" junto a los datos no verificados.
# Déjalo en "true" hasta que CESDMA confirme todos los datos.
PUBLIC_SHOW_PENDING=true
